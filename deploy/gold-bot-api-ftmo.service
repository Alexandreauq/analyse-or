[Unit]
Description=Bot Or - API interrupteur d'urgence (instance FTMO)
After=network.target

[Service]
Type=simple
User=goldbot
WorkingDirectory=/home/goldbot/analyse-or-ftmo
EnvironmentFile=/home/goldbot/analyse-or-ftmo/.env
ExecStart=/home/goldbot/analyse-or-ftmo/venv/bin/uvicorn gold_bot.api:app --host 0.0.0.0 --port 8444 --ssl-keyfile /etc/letsencrypt/live/goldbot.fr/privkey.pem --ssl-certfile /etc/letsencrypt/live/goldbot.fr/fullchain.pem
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
