[Unit]
Description=Bot Or - boucle de trading (instance FTMO)
After=network.target

[Service]
Type=simple
User=goldbot
WorkingDirectory=/home/goldbot/analyse-or-ftmo
EnvironmentFile=/home/goldbot/analyse-or-ftmo/.env
ExecStart=/home/goldbot/analyse-or-ftmo/venv/bin/python3 -m gold_bot.loop
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
